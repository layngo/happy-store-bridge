# OpenAI — powers chatbot answers when local FAQ doesn't match
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini

# Optional production chat endpoint (defaults to /api/chat)
# VITE_CHAT_API_URL=

# Production reviews API — optional override (default is Cloudflare Worker in reviewApi.ts).
# VITE_REVIEWS_API_URL=https://happy-store-bridge.tommy-4fd.workers.dev

# Cloudflare Turnstile — footer newsletter bot protection
# Create keys at https://dash.cloudflare.com/?to=/:account/turnstile
# Site key (public, baked into the client build):
VITE_TURNSTILE_SITE_KEY=
# Secret key (server only — .env locally, Cloudflare Pages env in production):
TURNSTILE_SECRET_KEY=

# Published reviews — Cloudflare Worker proxies /api/reviews to n8n with this secret header.
# Set the same value in Cloudflare Worker env and the n8n "Authorized?" node.
# Optional override if you rotate the n8n webhook path:
# REVIEWS_LIST_WEBHOOK_URL=https://layngo.app.n8n.cloud/webhook/layngo-reviews-internal
REVIEWS_LIST_WEBHOOK_SECRET=
